<resources xmlns:tools="http://schemas.android.com/tools">

  <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
    <!-- Customize your theme here. -->
    <item name="colorPrimary">@color/primary</item>
    <item name="colorPrimaryDark">@color/primaryDark</item>
    <item name="colorAccent">@color/accent</item>
    <item name="android:statusBarColor">@color/statusBar</item>
    <item name="android:navigationBarColor">@color/navigationBar</item>
  </style>


  <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:statusBarColor">@color/statusBar</item>
    <item name="android:navigationBarColor">@color/navigationBar</item>
    <item name="windowActionBar">false</item>
    <item name="windowNoTitle">true</item>
    <item name="android:background">@null</item>
  </style>


  <!-- Widget quick add: a floating dialog over the home screen that follows
       the system day/night setting, in the widget's brand color. -->
  <style name="AppTheme.QuickAdd" parent="Theme.AppCompat.DayNight.Dialog.Alert">
    <item name="colorAccent">@color/widget_brand</item>
    <item name="windowNoTitle">true</item>
  </style>


  <style name="AppTheme.NoActionBarLaunch" >
    <item name="android:windowActionBarOverlay">true</item>
    <!--
      Theme-colored window decor (was @null). With @null the decor falls back to
      the static Light AppTheme default (~white), which the adjustResize keyboard
      animation can briefly expose behind the WebView as a white flash even in
      dark mode. @color/windowBackground has a values-night variant (#131314), so
      this tracks system day/night; the in-app theme toggle (which can diverge
      from the system setting) is kept in sync at runtime by
      NavigationBarPlugin.setWebViewBackgroundColor.
    -->
    <item name="android:windowBackground">@color/windowBackground</item>
    <item name="windowActionBar">false</item>
    <item name="windowNoTitle">true</item>
    <item name="android:background">@null</item>
    <item name="android:navigationBarColor">@color/navigationBar</item>
    <!--
      Android 12+ system splash. Without this the OS draws the launcher icon on
      the theme's colorBackground, which is white here (AppTheme is the static
      Theme.AppCompat.Light.* family, not DayNight) — so the loading icon shows a
      white background even in dark mode. @color/windowBackground has a
      values-night variant (#131314), so the splash tracks system day/night.
    -->
    <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/windowBackground</item>
  </style>

</resources>
