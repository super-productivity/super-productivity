<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ system splash icon for windows 600dp and wider (tablets,
  landscape phones). Same as drawable/ic_splash.xml, but centred: at this
  width the web boot splash has no bottom bar (src/index.html, max-width:
  599px), so its logo sits in the middle of the screen like the system icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">
  <group
      android:scaleX="1.125"
      android:scaleY="1.125"
      android:translateX="108"
      android:translateY="108">
    <path
        android:fillColor="@color/splash_icon"
        android:pathData="M0.6554,34.5828 L32.4523,63.8553 63.7915,0.9436 30.2226,47.722Z" />
  </group>
</vector>
