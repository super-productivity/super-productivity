{
  "name": "@sp/shared-schema",
  "version": "1.0.0",
  "description": "Shared schema versioning and migrations for Super Productivity sync",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "supersync-http-contract": [
        "./dist/supersync-http-contract.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./supersync-http-contract": {
      "import": {
        "types": "./dist/supersync-http-contract.d.mts",
        "default": "./dist/supersync-http-contract.mjs"
      },
      "require": {
        "types": "./dist/supersync-http-contract.d.ts",
        "default": "./dist/supersync-http-contract.js"
      }
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "tsup",
    "build:tsc": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5.0.0 || ^6.0.0",
    "vitest": "^5.0.3"
  }
}
