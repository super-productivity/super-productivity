{
  "id": "google-calendar-provider",
  "name": "Google Calendar",
  "version": "1.0.0",
  "manifestVersion": 1,
  "minSupVersion": "13.0.0",
  "type": "issueProvider",
  "icon": "icon.svg",
  "iFrame": false,
  "permissions": ["oauth", "http"],
  "dataSharing": [
    {
      "recipient": "Google Calendar",
      "hosts": ["www.googleapis.com", "oauth2.googleapis.com", "accounts.google.com"],
      "data": [
        "credentials",
        "taskTitles",
        "taskNotes",
        "taskSchedule",
        "taskStatus",
        "ids"
      ],
      "privacyPolicyUrl": "https://policies.google.com/privacy"
    }
  ],
  "hooks": [],
  "issueProvider": {
    "pollIntervalMs": 60000,
    "icon": "calendar",
    "humanReadableName": "Google Calendar",
    "issueStrings": {
      "singular": "Event",
      "plural": "Events"
    },
    "useAgendaView": true,
    "defaultAutoAddToBacklog": false
  }
}
