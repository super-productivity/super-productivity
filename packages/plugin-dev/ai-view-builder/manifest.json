{
  "name": "AI View Builder",
  "id": "ai-view-builder",
  "manifestVersion": 1,
  "version": "1.0.0",
  "minSupVersion": "19.3.0",
  "description": "Describe a view in plain words and let Claude build it: a board, a matrix, a focus screen. Uses your own Anthropic API key. Only your prompts and the view's code are sent; your tasks stay on this device.",
  "author": "Super Productivity",
  "permissions": [
    "getTasks",
    "getArchivedTasks",
    "getCurrentContextTasks",
    "addTask",
    "updateTask",
    "deleteTask",
    "reorderTasks",
    "selectTask",
    "getAllProjects",
    "addProject",
    "updateProject",
    "getAllTags",
    "addTag",
    "updateTag",
    "getAppState",
    "getActiveWorkContext",
    "dispatchAction",
    "showSnack",
    "persistDataSynced",
    "loadSyncedData",
    "listSyncedDataKeys",
    "setSecret",
    "getSecret",
    "deleteSecret"
  ],
  "hooks": [
    "anyTaskUpdate",
    "projectListUpdate",
    "workContextChange",
    "currentTaskChange",
    "persistedDataChanged"
  ],
  "iFrame": true,
  "isSkipMenuEntry": false,
  "uiKit": true,
  "icon": "icon.svg"
}
