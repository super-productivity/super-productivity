{
  "name": "AI View Builder",
  "id": "ai-view-builder",
  "manifestVersion": 1,
  "version": "1.0.0",
  "minSupVersion": "19.3.0",
  "description": "Say or type the view you want, like a board, a matrix or a weekly review, and watch it rearrange. Uses your own Anthropic API key. Only your request and the view's layout are sent; your tasks stay on this device.",
  "author": "Super Productivity",
  "permissions": [
    "getTasks",
    "getArchivedTasks",
    "updateTask",
    "selectTask",
    "getAllProjects",
    "getAllTags",
    "addTag",
    "getActiveWorkContext",
    "getDayContext",
    "getCurrentTaskId",
    "startTracking",
    "stopTracking",
    "showSnack",
    "persistDataSynced",
    "loadSyncedData",
    "listSyncedDataKeys",
    "setSecret",
    "getSecret",
    "deleteSecret",
    "showInWorkContext",
    "closeWorkContextView",
    "registerWorkContextHeaderButton"
  ],
  "hooks": ["dataChanged", "dayChange", "workContextChange", "persistedDataChanged"],
  "iFrame": true,
  "isSkipMenuEntry": false,
  "uiKit": true,
  "icon": "icon.svg"
}
