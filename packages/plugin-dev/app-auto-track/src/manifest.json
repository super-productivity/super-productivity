{
  "id": "app-auto-track",
  "manifestVersion": 1,
  "name": "App Auto Track (Alpha)",
  "version": "0.1.0",
  "description": "Desktop (macOS, Windows): suggests the task matching the app or window you work in, via your rules or issue keys like PROJ-123 in the window title.",
  "author": "Super Productivity",
  "homepage": "https://github.com/super-productivity/super-productivity",
  "minSupVersion": "19.1.0",
  "permissions": [
    "getTasks",
    "showSnack",
    "dispatchAction",
    "registerHook",
    "nodeExecution"
  ],
  "nodeScriptConfig": {
    "timeout": 10000,
    "memoryLimit": "64MB"
  },
  "hooks": ["currentTaskChange"],
  "iFrame": false,
  "isSkipMenuEntry": true,
  "jsonSchemaCfg": "config-schema.json",
  "icon": "icon.svg",
  "i18n": {
    "languages": ["en"]
  }
}
